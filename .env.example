# Run all Python commands from the repository root.
DATABASE_URL=sqlite:///./incidentmind.db
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
PROVIDER_TIMEOUT=90
# Local backend -> local Hindsight. Compose overrides this to http://hindsight:8888.
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=j76-incidentmind
CORS_ORIGINS=http://localhost:3000
# Hindsight has its own extraction/reflection provider configuration.
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-120b
# Optional server-side Next.js proxy target; defaults to localhost:8000.
BACKEND_URL=http://127.0.0.1:8000
# Browser websocket endpoint; configured at frontend build time.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/events
