{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "j76-incidentmind-api",
  "main": "cloudflare/api-worker.ts",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "j76-incidentmind",
      "database_id": "01229c60-e3d8-45e2-adec-b2efbba23e68",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "LLM_BASE_URL": "https://api.groq.com/openai/v1",
    "LLM_MODEL": "openai/gpt-oss-120b",
    "HINDSIGHT_URL": "https://api.hindsight.vectorize.io",
    "HINDSIGHT_BANK_ID": "j76-incidentmind"
  },
  "observability": {
    "enabled": true
  }
}
